# archive-governor — 版本管理排除
# 2026-08-11 开源化: 内部协作资产 / 本地配置 / 敏感数据一律不进 git

# ── 内部协作资产 (不对外发布) ──────────────────────────────────────────
# exchange/ 含 agent 代号、内部协议引用、kanban 卡号等组织内部信息
exchange/
# 内部勘察/验收证据 (真实生产库路径与大小)
docs/PRODUCTION-DB-*.md
docs/B1-*.txt
docs/B2-*.txt
docs/t_*-evidence.md
docs/kanban-watchdog.md
# 内部阶段报告
MVP2-reclaim-report-*.txt

# ── 本地配置 (含真实路径, 不进 git) ───────────────────────────────────
config/governance.local.yaml

# ── 回归/临时产物 ─────────────────────────────────────────────────────
tmp/
.tmp/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/

# ── 日志 ──────────────────────────────────────────────────────────────
logs/*.log

# ── 测试残留 ──────────────────────────────────────────────────────────
scripts/test_write.txt

# ── 一次性内部验证脚本 ────────────────────────────────────────────────
_b1_indep_test.sh

# ── 内部运维文档 (含真实路径/内部模板来源, 不对外) ────────────────────
ROLLBACK.md
SAFETY.md
